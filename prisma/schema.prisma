// Onion and Back — database schema.
// See docs/blueprint.md §4 for the design rationale.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  cliente
  admin
  operario
}

// Mirrors the business's own Leyenda_Estados sheet.
enum OrderStatus {
  pendiente_pago
  pagado
  en_diseno
  en_aprobacion
  en_produccion
  terminado
  entregado
}

enum OrderPriority {
  vencido
  critico
  alta
  media
  baja
}

enum PaymentMethod {
  tarjeta
  bizum
  transferencia
}

enum PaymentStatus {
  pendiente
  pagado
  fallido
}

enum DiscountType {
  un_solo_uso
  cliente_habitual
}

enum SupplierOrderStatus {
  borrador
  confirmado
  enviado
  error
  cancelado
}

model Supplier {
  id         String    @id @default(uuid())
  name       String    @unique
  adapterKey String // key into src/lib/suppliers/*
  active     Boolean   @default(true)
  products   Product[]

  @@map("suppliers")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")
  products Product[]

  @@map("categories")
}

// Cross-cutting tag, independent of Category: bodas, despedidas, colegios...
model Occasion {
  id       String            @id @default(uuid())
  name     String            @unique
  slug     String            @unique
  products ProductOccasion[]

  @@map("occasions")
}

model Product {
  id                 String            @id @default(uuid())
  supplierId         String
  supplier           Supplier          @relation(fields: [supplierId], references: [id])
  supplierSku        String // rootmodel / código base del proveedor
  name               String
  description        String?
  // Marca del fabricante (Valento, Roly, Kariban...) — distinta del
  // proveedor/distribuidor (supplier): un mismo proveedor (TopTex) puede
  // distribuir varias marcas. Null cuando el proveedor no la reporta (Cifra).
  brand              String?
  subcategory        String?
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id])
  basePrice          Decimal           @db.Decimal(10, 2)
  material           String?
  engravingTechnique String?
  stock              Int               @default(0)
  // Maestro de precios (Finanzas, 2026-09-30) — tramos de cantidad del
  // proveedor a nivel de modelo. Null = sin dato todavía (ver
  // incompleteData). Uds_caja de ROCK/LUA/DAN ya viene resuelta al máximo
  // por talla en el maestro, no hace falta lógica especial aquí.
  unitsPerPack       Int?
  unitsPerCase       Int?
  minOrderQty        Int?
  // Código propio cross-proveedor (prefijo ROL-/STA-/CIF-/TTX-/VAL- +
  // código del modelo) — soluciona que supplierModelCode solo sea único
  // dentro de la práctica actual, no por diseño (ver ProductVariant).
  // Sin @unique todavía: se añade en un paso aparte una vez cargado el
  // maestro completo, para no necesitar --accept-data-loss sobre una
  // columna que hoy está vacía en todas las filas.
  supplierCode       String?
  // Código recortado para FACTUSOL (máx. 13 caracteres) cuando
  // supplierCode no cabe — ver Codigos_largos.csv del maestro.
  factusolCode       String?
  // true = falta unitsPerPack/unitsPerCase en el maestro; la web debe usar
  // siempre el precio de unidad (regla de repliegue, nunca precio 0).
  incompleteData     Boolean           @default(false)
  lastSyncedAt       DateTime          @default(now())
  variants           ProductVariant[]
  images             ProductImage[]
  occasions          ProductOccasion[]

  @@unique([supplierId, supplierSku])
  @@index([categoryId, supplierId])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(uuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  size               String?
  color              String?
  price              Decimal             @db.Decimal(10, 2)
  // Maestro de precios — precio de venta (coste × 2) en tramo pack/caja.
  // Null cuando el modelo no tiene ese tramo (ver Product.unitsPerPack/Case).
  pricePack          Decimal?            @db.Decimal(10, 2)
  priceBox           Decimal?            @db.Decimal(10, 2)
  // Coste real del proveedor por tramo, 4 decimales (el maestro trae hasta
  // 5) — para desglose en pedidos/informes, nunca se muestra al cliente.
  costUnit           Decimal?            @db.Decimal(10, 4)
  costPack           Decimal?            @db.Decimal(10, 4)
  costBox            Decimal?            @db.Decimal(10, 4)
  stock              Int                 @default(0)
  supplierModelCode  String              @unique // código real de esta variante en el proveedor (trazabilidad)
  orderLines         OrderLine[]
  supplierOrderLines SupplierOrderLine[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  position  Int     @default(0)
  // Color exacto (mismo string que ProductVariant.color) si el proveedor
  // da una foto distinta por color — null = foto genérica del producto,
  // no ligada a ningún color concreto. Petición del dueño, 2026-10-01: al
  // pulsar un color en la ficha, la foto principal debe cambiar si hay una
  // específica para ese color (ej. Dogo de Roly).
  color     String?

  @@map("product_images")
}

model ProductOccasion {
  productId  String
  occasionId String
  product    Product  @relation(fields: [productId], references: [id])
  occasion   Occasion @relation(fields: [occasionId], references: [id])

  @@id([productId, occasionId])
  @@map("product_occasions")
}

model User {
  id                      String          @id @default(uuid())
  email                   String          @unique
  passwordHash            String?
  name                    String?
  marketingConsent        Boolean         @default(false)
  role                    UserRole        @default(cliente)
  // +1 en cada logout de admin; invalida cualquier token firmado antes de
  // ese momento (copiado o no) — parche de seguridad, Guardian P7, 2026-10-02.
  sessionVersion          Int             @default(0)
  createdAt               DateTime        @default(now())
  orders                  Order[]
  confirmedSupplierOrders SupplierOrder[]

  @@map("users")
}

model Order {
  id                 String        @id @default(uuid())
  userId             String?
  user               User?         @relation(fields: [userId], references: [id])
  status             OrderStatus   @default(pendiente_pago)
  priority           OrderPriority @default(media)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(pendiente)
  deliveryTargetDate DateTime?
  total              Decimal       @db.Decimal(10, 2)
  // Facturación — obligatorio en todo pedido (particular o empresa/ayuntamiento).
  invoiceName        String
  invoiceTaxId       String
  // Dirección de facturación — necesaria para la factura real y para el
  // exportador de FactuSol (columnas Domicilio/Población/CP/Provincia de CLI).
  invoiceAddress     String
  invoicePostalCode  String
  invoiceCity        String
  invoiceProvince    String
  // Contacto directo — obligatorio porque el checkout no exige cuenta de
  // cliente (userId es opcional); es la única forma de avisar del pago.
  contactEmail       String
  contactPhone       String?
  // Código de descuento aplicado, si lo hubo — ver src/lib/discounts.ts.
  discountCodeId     String?
  discountCode       DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountAmount     Decimal       @default(0) @db.Decimal(10, 2)
  // Envío al cliente — 6€ fijo, gratis desde 300€ de importe final (con
  // descuento e IVA incluidos, sin contar el propio envío). Ver crearPedido.
  shippingCost       Decimal       @default(0) @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  lines              OrderLine[]
  // Número de documento de FactuSol (PCL/LPC col. B) — correlativo desde 1,
  // asignado la primera vez que se exporta (individual o en bloque) y
  // conservado después (Josep/Finanzas, 2026-10-02: su FactuSol no tiene
  // ningún pedido de cliente creado todavía, así que no hace falta que
  // coincida con nada existente, solo que no se repita ni cambie).
  factusolDocNumber  Int?          @unique
  // Se rellena la primera vez que el pedido se incluye en un ZIP de
  // FactuSol (descarga individual o el botón de exportación en bloque) —
  // el export en bloque solo coge pedidos con esto a null, para no
  // duplicar un pedido ya mandado a FactuSol.
  factusolExportedAt DateTime?

  @@index([status, priority])
  @@map("orders")
}

// Una línea de pedido — equivalente a la hoja "Pedidos" del Excel del negocio:
// permite nombre/talla individual por unidad (equipaciones de equipo).
model OrderLine {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId    String?
  productVariant      ProductVariant?    @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  quantity            Int
  individualName      String?
  individualNumber    String? // dorsal
  unitPrice           Decimal            @db.Decimal(10, 2)
  // Desglose del precio de la línea — solo para informes/FactuSol, no se
  // muestra al cliente. garmentCost/markingCost en Decimal(10,2) porque son
  // precio de venta ya redondeado, no el coste proveedor (ver
  // ProductVariant.costUnit para eso).
  garmentCost         Decimal?           @db.Decimal(10, 2)
  markingCost         Decimal?           @db.Decimal(10, 2)
  // "unidad" | "pack" | "caja" — qué tramo se aplicó a esta línea.
  priceTier           String?
  design              DesignConfig?
  // Tanda de pedido a proveedor que ya recogió esta línea — null hasta que
  // corre el batch runner (ver runBatch en supplier-batch-runner.ts). Una
  // OrderLine aporta siempre su cantidad entera a una única SupplierOrderLine.
  supplierOrderLineId String?
  supplierOrderLine   SupplierOrderLine? @relation(fields: [supplierOrderLineId], references: [id], onDelete: SetNull)
  // Marcaje de la línea, una fila por zona activa (técnica + tamaño + colores).
  // Hasta 2026-10-03 la técnica solo se usaba al calcular el precio y no se
  // guardaba — el export a FactuSol no podía generar las líneas de marcaje.
  marks               OrderLineMarking[]

  @@map("order_lines")
}

model OrderLineMarking {
  id          String    @id @default(uuid())
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  // "pecho" | "espalda" | "manga_izquierda" | "manga_derecha" | "manga"
  zone        String
  // "Serigrafia" | "DTF" | "Sublimacion" | "Vinilo" (ver Technique en pricing.ts)
  technique   String
  // "10x10" | "22x22" | "28x28" — null en serigrafía (la tarifa va por colores)
  size        String?
  // Solo serigrafía: 1, 2 o 3.
  colors      Int?
  // Tramo con el que markingUnitPrice calculó el precio (1, 5, 10, 25, 50,
  // 100, 250, 500) y precio de marcaje por unidad SIN IVA de ese momento —
  // el pedido es reproducible aunque cambie la tarifa. Ver marking-tariff.ts.
  tierQty     Int
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  // Código de artículo de FactuSol (ej. DTF22_25); null en serigrafía <10 uds.
  factusolCode String?
  // Color del marcaje que indicó el cliente (ej. "Blanco") — producción lo
  // necesita para no estampar un logo blanco sobre prenda blanca. Null si no
  // lo indicó o la técnica no lo pide (sublimación).
  colorName   String?

  @@index([orderLineId])
  @@map("order_line_markings")
}

// Pedido consolidado a un proveedor (canal de envío real — ver adapterKey),
// generado dos veces al día a partir de las OrderLine de pedidos ya pagados
// que todavía no se han asignado a ninguna tanda. Nunca se envía nada al
// proveedor sin que un admin lo confirme explícitamente (confirmarTanda).
model SupplierOrder {
  id                      String              @id @default(uuid())
  // "gorfactory" | "toptex" | "valento" | "cifra" — canal de envío real, NO
  // Supplier.id: Roly y Stamina comparten cuenta/API de Gorfactory, así que
  // caen en la misma tanda (ver plan "Tandas de pedido a proveedor").
  adapterKey              String
  batchRunAt              DateTime
  status                  SupplierOrderStatus @default(borrador)
  // "api" (Gorfactory/TopTex, se envía via placeOrder()/createOrder()) o
  // "manual" (Valento/Cifra, Josep lo pide él mismo con el texto generado).
  fulfillmentMode         String
  subtotal                Decimal             @default(0) @db.Decimal(10, 2)
  handlingFee             Decimal             @default(0) @db.Decimal(10, 2)
  shippingCost            Decimal             @default(0) @db.Decimal(10, 2)
  // Solo Gorfactory — sin fórmula automática, lo decide Josep en el borrador
  // según el volumen antes de confirmar (ver gorfactoryShipping).
  parcelCount             Int?
  quoteFromAccountManager Boolean             @default(false)
  supplierOrderCode       String?
  placedAt                DateTime?
  confirmedAt             DateTime?
  confirmedById           String?
  confirmedBy             User?               @relation(fields: [confirmedById], references: [id])
  // Resumen de redondeos a caja / sobrante para que Josep lo revise antes
  // de confirmar (ver consolidateSku en supplier-batching.ts).
  notes                   String?
  createdAt               DateTime            @default(now())
  lines                   SupplierOrderLine[]

  @@index([adapterKey, batchRunAt])
  @@map("supplier_orders")
}

model SupplierOrderLine {
  id                 String         @id @default(uuid())
  supplierOrderId    String
  supplierOrder      SupplierOrder  @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  productVariantId   String
  productVariant     ProductVariant @relation(fields: [productVariantId], references: [id])
  requestedQuantity  Int
  // requestedQuantity, o redondeado a unitsPerCase si compensa por precio
  // (ver consolidateSku en supplier-batching.ts).
  orderedQuantity    Int
  priceTier          String
  unitCost           Decimal        @db.Decimal(10, 4)
  lineCost           Decimal        @db.Decimal(10, 2)
  boxRounded         Boolean        @default(false)
  surplusQuantity    Int            @default(0)
  handlingFeeApplied Boolean        @default(false)
  orderLines         OrderLine[]

  @@unique([supplierOrderId, productVariantId])
  @@map("supplier_order_lines")
}

// Configuración del diseñador visual — una por línea de pedido.
model DesignConfig {
  id              String    @id @default(uuid())
  orderLineId     String    @unique
  orderLine       OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  logoFileUrl     String // URL en Cloudflare R2
  markings        Json // lista de marcas: zona, posición, tamaño, técnica — ver Anexo A del blueprint
  previewImageUrl String // mockup renderizado, usado en la hoja de trabajo imprimible

  @@map("design_configs")
}

// Banners de campañas de temporada en la home (Día del Padre, Navidad...).
// Se activan por rango de fechas — ver src/lib/promotions.ts.
model Promotion {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String
  ctaLabel  String   @default("Ver ofertas")
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("promotions")
}

// Códigos de descuento: un solo uso (campañas puntuales) o para clientes
// habituales (reutilizable, atado opcionalmente a un email concreto).
// Ver src/lib/discounts.ts.
model DiscountCode {
  id            String       @id @default(uuid())
  code          String       @unique
  type          DiscountType
  percentage    Int
  maxUses       Int? // null = ilimitado
  usesCount     Int          @default(0)
  customerEmail String? // obligatorio (vía validate() del admin) solo para cliente_habitual
  expiresAt     DateTime?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  orders        Order[]

  @@map("discount_codes")
}

// Código de cliente de FACTUSOL por NIF — FACTUSOL necesita un código
// numérico de cliente que siga SU numeración real, no uno inventado (un
// hash podía colisionar con un cliente que Josep ya tuviera dado de alta a
// mano). Último código real confirmado por Josep, 2026-10-02: 181, así que
// el siguiente cliente nuevo de la web empieza en 182 y sube de uno en uno
// (ver nextFactusolClientCode() en src/lib/factusol.ts). Josep puede
// corregir el código de un NIF concreto desde la página del pedido en el
// admin (p.ej. un cliente que ya existía en FACTUSOL antes de la web, con
// un código bajo como 81) — esa corrección se guarda aquí y se reutiliza en
// todos los pedidos futuros de ese mismo NIF, no solo el que se está
// editando.
model FactusolClient {
  nif       String   @id
  code      Int      @unique
  createdAt DateTime @default(now())

  @@map("factusol_clients")
}
